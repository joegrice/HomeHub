# ── Trains ───────────────────────────────────────────────────────────────────
# National Rail CRS station code (e.g. WAT, MAN, EUS, CHE)
# Find yours at: https://www.nationalrail.co.uk/stations_destinations/48541.aspx
STATION_CRS=CHE

# Huxley2 token — optional, gives higher rate limits
# Register free at: https://huxley2.azurewebsites.net
HUXLEY2_TOKEN=

# ── Tube ─────────────────────────────────────────────────────────────────────
# TfL Unified API key — free at https://api.tfl.gov.uk
TFL_API_KEY=your_tfl_api_key_here

# ── Weather ───────────────────────────────────────────────────────────────────
# Met Office DataHub key — free tier at https://datahub.metoffice.gov.uk
METOFFICE_API_KEY=your_metoffice_api_key_here

# Your location — postcode takes priority over lat/lng (outward code is fine, e.g. SW1A)
WEATHER_POSTCODE=SW1A
# WEATHER_LAT=51.5074
# WEATHER_LNG=-0.1278

# ── Calendar ─────────────────────────────────────────────────────────────────
# Source: "ical" (default) or "gmail"
CALENDAR_SOURCE=ical

# iCal/CalDAV URL — works with iCloud, Outlook, Google Calendar
# webcal:// URLs are automatically rewritten to https://
ICAL_URL=webcal://your-private-ical-url-here

# Only needed if CALENDAR_SOURCE=gmail
# Paste the full service account JSON as a single-line string
GOOGLE_SERVICE_ACCOUNT_KEY=

# ── Refresh intervals (minutes, decimals allowed) ─────────────────────────────
REFRESH_TRAINS_MINUTES=0.5
REFRESH_TUBE_MINUTES=2
REFRESH_WEATHER_MINUTES=15
REFRESH_CALENDAR_MINUTES=5
REFRESH_NEWS_MINUTES=5
